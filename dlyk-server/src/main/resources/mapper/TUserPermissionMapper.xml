<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.bjpowernode.mapper.TUserPermissionMapper">

  <resultMap id="BaseResultMap" type="com.bjpowernode.model.TUserPermission">
    <id column="id" jdbcType="INTEGER" property="id" />
    <result column="user_id" jdbcType="INTEGER" property="userId" />
    <result column="permission_id" jdbcType="INTEGER" property="permissionId" />
  </resultMap>

  <select id="selectPermissionIdsByUserId" parameterType="java.lang.Integer" resultType="java.lang.Integer">
    select permission_id from t_user_permission where user_id = #{userId}
  </select>

  <insert id="insertBatch" parameterType="java.util.List">
    insert into t_user_permission (user_id, permission_id) values
    <foreach collection="list" item="item" separator=",">
      (#{item.userId}, #{item.permissionId})
    </foreach>
  </insert>

  <delete id="deleteByUserId" parameterType="java.lang.Integer">
    delete from t_user_permission where user_id = #{userId}
  </delete>
</mapper>